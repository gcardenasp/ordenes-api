# Copiar a .env y asignar valores. El archivo .env no se sube al repositorio.

# Base de datos local (docker-compose)
ORACLE_PASSWORD=
APP_USER=ordenes
APP_USER_PASSWORD=

# Aplicación (DB_USER y DB_PASSWORD son los mismos APP_USER y APP_USER_PASSWORD)
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USER=ordenes
DB_PASSWORD=
# Clave HS256 para firmar y validar los JWT: mínimo 32 bytes (256 bits)
JWT_SECRET=
